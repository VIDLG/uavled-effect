{
  "name": "uavled-effects",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "node scripts/build.mjs --sync",
    "check": "node scripts/build.mjs --check",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "sim:dev": "node scripts/build.mjs && node simulator/scripts/setup-assets.mjs && vite --config simulator/vite.config.js",
    "sim:build": "node scripts/build.mjs && node simulator/scripts/setup-assets.mjs && vite build --config simulator/vite.config.js",
    "sim:preview": "vite preview --config simulator/vite.config.js",
    "tool:compile": "node tools/cli.mjs compile",
    "tool:simulate": "node tools/cli.mjs simulate",
    "mcp:serve": "node tools/mcp-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "lucide-react": "^0.548.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.3",
    "react-native-skia": "3.7.4",
    "react-native-web": "0.21.1",
    "react-native-worklets": "0.7.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "1.64.1",
    "vite": "6.4.5"
  }
}
